<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="api_log_tree_view" model="ir.ui.view">
        <field name="name">api.log.tree.view</field>
        <field name="model">api.log</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="url"/>
                <field name="status"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>
    
    <record id="api_log_form_view" model="ir.ui.view">
        <field name="name">api.log.form.view</field>
        <field name="model">api.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="header"/>
                            <field name="status"/>
                        </group>
                        <group>
                            <field name="url"/>
                            <field name="body"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <field name="log_line_ids">
                        <tree>
                            <field name="code"/>
                            <field name="response"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_api_log" model="ir.actions.act_window">
        <field name="name">API Log</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">api.log</field>
        <field name="view_id" ref='fazri_custom.api_log_tree_view'/>
    </record>

    <menuitem 
        id="manu_api_log"
        name="API Log"
        parent="base.menu_administration"
        sequence="10"
        action="fazri_custom.action_api_log"
    />
</odoo>
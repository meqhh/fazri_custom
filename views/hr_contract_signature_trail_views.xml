<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="hr_contract_signature_trail_view_form" model="ir.ui.view">
        <field name="name">hr.contract.signature.trail.form</field>
        <field name="model">hr.contract.signature.trail</field>
        <field name="arch" type="xml">
            <form string="Signature Trail" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="Signer Information">
                            <field name="signer_type" readonly="1"/>
                            <field name="signer_name" readonly="1"/>
                            <field name="signer_email" readonly="1"/>
                            <field name="signer_phone" readonly="1"/>
                            <field name="signer_user_id" readonly="1"/>
                        </group>
                        <group string="Status and Time">
                            <field name="state" readonly="1"/>
                            <field name="document_created_at" readonly="1"/>
                            <field name="signed_at" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <!-- <group string="Technical Information">
                            <field name="ip_address" readonly="1"/>
                            <field name="user_agent" readonly="1"/>
                            <field name="access_token" readonly="1"/>
                        </group> -->
                        <group string="Attachment">
                            <field name="signature_image"
                                widget="image"
                                string="Signature"
                                readonly="1"
                                nolabel="0"
                                invisible="not signature_image"
                                options="{'size': [300, 150]}"/>
                            <field name="signature_attachment_id"
                                string="Attachment Reference"
                                readonly="1"
                                invisible="not signature_attachment_id"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="note" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_contract_signature_trail_view_tree" model="ir.ui.view">
        <field name="name">hr.contract.signature.trail.tree</field>
        <field name="model">hr.contract.signature.trail</field>
        <field name="arch" type="xml">
            <tree string="Signature Trail Log"
                create="false"
                edit="false"
                delete="false"
                decoration-success="state == 'signed'"
                decoration-warning="state == 'pending'">
                <field name="signer_type" string="Signer Type" widget="badge"
                    decoration-info="signer_type == 'candidate'"
                    decoration-primary="signer_type == 'hr'"/>
                <field name="signer_name" string="Name"/>
                <field name="signer_user_id" string="HR User"/>
                <field name="state" string="Status" widget="badge"
                    decoration-success="state == 'signed'"
                    decoration-warning="state == 'pending'"/>
                <field name="document_created_at" string="Document Created"/>
                <field name="signed_at" string="Signed At"/>
                <field name="ip_address" string="IP Address"/>
                <field name="user_agent" string="User Agent" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="hr_contract_signature_trail_form_inherit" model="ir.ui.view">
        <field name="name">hr.contract.form.signature.trail.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='information']" position="before">
                <page string="Signature Trail Log" name="signature_trail">
                    <group>
                        <group string="Overall Signature Status">
                            <field name="signature_state" readonly="1"
                                widget="badge"
                                decoration-muted="signature_state == 'draft'"
                                decoration-warning="signature_state in ['candidate_signed', 'hr_pending']"
                                decoration-success="signature_state == 'completed'"/>
                        </group>
                    </group>
                    <separator string="Signature History"/>
                    <field name="signature_trail_ids"
                        widget="one2many_list"
                        mode="tree"
                        readonly="1"
                        nolabel="1">
                        <tree string="Signature Trail"
                            create="false"
                            edit="false"
                            delete="false"
                            decoration-success="state == 'signed'"
                            decoration-warning="state == 'pending'">
                            <field name="signer_type" string="Signer Type" widget="badge"
                                decoration-info="signer_type == 'candidate'"
                                decoration-primary="signer_type == 'hr'"/>
                            <field name="signer_name" string="Signer Name"/>
                            <field name="signer_user_id" string="HR User"/>
                            <field name="state" string="Status" widget="badge"
                                decoration-success="state == 'signed'"
                                decoration-warning="state == 'pending'"/>
                            <field name="document_created_at" string="Document Created"/>
                            <field name="signed_at" string="Signed At"/>
                            <field name="ip_address" string="IP Address"/>
                            <field name="user_agent" string="User Agent" optional="show"/>
                        </tree>
                    </field>
                    <div class="mt-3"
                         invisible="signature_state == 'completed'">
                        <field name="employer_sign_token" invisible="1"/>
                        <!-- <button type="object"
                                name="action_employer_sign"
                                string="Open HR Sign Form"
                                class="btn-primary"
                                title="Open the HR signature form (login required)"/> -->
                    </div>
                </page>
            </xpath>

        </field>
    </record>

    <record id="action_hr_contract_signature_trail" model="ir.actions.act_window">
        <field name="name">Signature Trail Log</field>
        <field name="res_model">hr.contract.signature.trail</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

</odoo>

<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="whatsapp_applicant_wizard_form" model="ir.ui.view">
        <field name="name">whatsapp.applicant.wizard.form</field>
        <field name="model">whatsapp.applicant.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <group>
                    <field name="applicant_id" invisible="1"/>
                    <field name="salary_offer_id" invisible="1"/>
                    <field name="partner_name"/>
                    <field name="phone_number"/>
                    <field name="appointment_date" invisible="salary_offer_id != False"/>
                    <field name="message" widget="text"/>
                </group>
                <footer>
                    <button name="action_send_whatsapp" string="Send" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_applicant_wizard" model="ir.actions.act_window">
        <field name="name">Send WhatsApp</field>
        <field name="res_model">whatsapp.applicant.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

        <field name="model">applicant.get.refuse.reason</field>
        <field name="inherit_id" ref="hr_recruitment.applicant_get_refuse_reason_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@invisible='not refuse_reason_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@role='alert']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
